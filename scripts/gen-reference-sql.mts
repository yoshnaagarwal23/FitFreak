// Generates the Supabase migration that inserts built-in exercises and foods from the
// app's seed files, so the cloud database and the app share one source of truth.
//
//   node --import ./tests/support/register.mjs scripts/gen-reference-sql.mts > supabase/migrations/20261022000003_reference_data.sql
//
// tests/reference-sql.test.mts fails if the committed migration drifts from the seeds.
import { SEED_EXERCISES, SEED_EXERCISES_V3 } from '@/db/seedExercises';
import { SEED_FOODS } from '@/db/seedFoods';

const q = (s: string) => `'${s.replace(/'/g, "''")}'`;

export function referenceSql(): string {
  const exercises = [...SEED_EXERCISES, ...SEED_EXERCISES_V3]
    .map((e) => `  (${q(e.name)}, ${q(e.muscleGroup)}, ${q(e.equipment)})`)
    .join(',\n');
  const foods = SEED_FOODS.map(
    (f) =>
      `  (${q(f.name)}, ${q(f.servingLabel)}, ${f.servingGrams}, ${f.calories}, ${f.protein}, ${f.carbs}, ${f.fat}, ${f.vegetarian}, ${q(f.source)})`,
  ).join(',\n');

  return `-- GENERATED by scripts/gen-reference-sql.mts from src/db/seedExercises.ts and src/db/seedFoods.ts.
-- Do not edit by hand; change the seed files and regenerate.

insert into public.exercises (name, muscle_group, equipment) values
${exercises};

insert into public.foods (name, serving_label, serving_grams, calories_100g, protein_100g, carbs_100g, fat_100g, is_vegetarian, source) values
${foods};
`;
}

if (import.meta.main) process.stdout.write(referenceSql());
